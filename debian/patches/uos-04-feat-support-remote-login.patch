@@ -0,0 +1,337 @@
+/*
+ * Runtime resolution selection for remote displays.
+ */
+
+#include "remote-display-resolution.h"
+
+#include <string.h>
+#include <sys/wait.h>
+
+typedef struct
+{
+    guint width;
+    guint height;
+} RemoteMode;
+
+static guint64
+remote_mode_area (const RemoteMode *mode)
+{
+    return (guint64) mode->width * (guint64) mode->height;
+}
+
+static gboolean
+remote_mode_equal (const RemoteMode *a, const RemoteMode *b)
+{
+    return a->width == b->width && a->height == b->height;
+}
+
+static gboolean
+remote_mode_parse (const gchar *text, RemoteMode *mode)
+{
+    if (!text || !g_ascii_isdigit (text[0]) || !mode)
+        return FALSE;
+
+    gchar *endptr = NULL;
+    guint64 width = g_ascii_strtoull (text, &endptr, 10);
+    if (!endptr || *endptr != 'x')
+        return FALSE;
+
+    gchar *height_start = endptr + 1;
+    if (!g_ascii_isdigit (*height_start))
+        return FALSE;
+
+    guint64 height = g_ascii_strtoull (height_start, &endptr, 10);
+    if (width == 0 || height == 0 || width > G_MAXUINT || height > G_MAXUINT)
+        return FALSE;
+
+    if (endptr && *endptr != '\0')
+        return FALSE;
+
+    mode->width = (guint) width;
+    mode->height = (guint) height;
+    return TRUE;
+}
+
+static gboolean
+remote_mode_list_contains (GArray *modes, const RemoteMode *mode)
+{
+    for (guint i = 0; modes && i < modes->len; i++)
+    {
+        RemoteMode *candidate = &g_array_index (modes, RemoteMode, i);
+        if (remote_mode_equal (candidate, mode))
+            return TRUE;
+    }
+
+    return FALSE;
+}
+
+static void
+remote_mode_list_add_unique (GArray *modes, const RemoteMode *mode)
+{
+    if (!remote_mode_list_contains (modes, mode))
+        g_array_append_val (modes, *mode);
+}
+
+static gint
+remote_mode_compare_desc (gconstpointer a, gconstpointer b)
+{
+    const RemoteMode *ma = a;
+    const RemoteMode *mb = b;
+    guint64 area_a = remote_mode_area (ma);
+    guint64 area_b = remote_mode_area (mb);
+
+    if (area_a < area_b)
+        return 1;
+    if (area_a > area_b)
+        return -1;
+    return 0;
+}
+
+static gint
+remote_mode_compare_asc (gconstpointer a, gconstpointer b)
+{
+    return -remote_mode_compare_desc (a, b);
+}
+
+static gboolean
+remote_display_parse_requested_mode (Seat *seat, RemoteMode *mode)
+{
+    const gchar *width_value = seat_get_string_property (seat, "remote-width");
+    const gchar *height_value = seat_get_string_property (seat, "remote-height");
+    if (!width_value || !height_value || !width_value[0] || !height_value[0])
+        return FALSE;
+
+    gchar *endptr = NULL;
+    guint64 width = g_ascii_strtoull (width_value, &endptr, 10);
+    if (!endptr || *endptr != '\0')
+        return FALSE;
+
+    guint64 height = g_ascii_strtoull (height_value, &endptr, 10);
+    if (!endptr || *endptr != '\0')
+        return FALSE;
+
+    if (width == 0 || height == 0 || width > G_MAXUINT || height > G_MAXUINT)
+        return FALSE;
+
+    mode->width = (guint) width;
+    mode->height = (guint) height;
+    return TRUE;
+}
+
+static gchar **
+remote_display_build_xrandr_env (XServerLocal *x_server)
+{
+    gchar **env = g_get_environ ();
+    env = g_environ_setenv (env, "DISPLAY", x_server_get_address (X_SERVER (x_server)), TRUE);
+
+    const gchar *path = x_server_local_get_authority_file_path (x_server);
+    if (path && path[0])
+        env = g_environ_setenv (env, "XAUTHORITY", path, TRUE);
+
+    return env;
+}
+
+static gboolean
+remote_display_run_xrandr (Seat *seat, gchar **env, gchar **argv, gchar **out)
+{
+    g_autofree gchar *stdout_text = NULL;
+    g_autofree gchar *stderr_text = NULL;
+    gint status = 0;
+    g_autoptr(GError) error = NULL;
+
+    gboolean started = g_spawn_sync (NULL,
+                                     argv,
+                                     env,
+                                     G_SPAWN_SEARCH_PATH,
+                                     NULL,
+                                     NULL,
+                                     &stdout_text,
+                                     &stderr_text,
+                                     &status,
+                                     &error);
+    if (!started)
+    {
+        l_warning (seat, "remote-display: xrandr failed to start: %s", error ? error->message : "unknown error");
+        return FALSE;
+    }
+
+    if (!WIFEXITED (status) || WEXITSTATUS (status) != 0)
+    {
+        l_warning (seat, "remote-display: xrandr command failed status=%d stderr=%s",
+                   status,
+                   stderr_text ? stderr_text : "");
+        return FALSE;
+    }
+
+    if (out)
+        *out = g_steal_pointer (&stdout_text);
+    return TRUE;
+}
+
+static gchar *
+remote_display_parse_xrandr_modes (const gchar *query, GArray *modes)
+{
+    g_auto(GStrv) lines = g_strsplit (query ? query : "", "\n", -1);
+    gboolean in_connected_output = FALSE;
+    gchar *output = NULL;
+
+    for (guint i = 0; lines && lines[i]; i++)
+    {
+        const gchar *line = lines[i];
+        if (!line[0])
+            continue;
+
+        if (!g_ascii_isspace (line[0]))
+        {
+            if (output)
+                break;
+
+            in_connected_output = FALSE;
+            if (strstr (line, " connected"))
+            {
+                g_auto(GStrv) fields = g_strsplit_set (line, " \t", 2);
+                if (fields && fields[0] && fields[0][0])
+                {
+                    g_free (output);
+                    output = g_strdup (fields[0]);
+                    in_connected_output = TRUE;
+                }
+            }
+            continue;
+        }
+
+        if (!in_connected_output)
+            continue;
+
+        g_auto(GStrv) fields = g_strsplit_set (g_strstrip ((gchar *) line), " \t", 2);
+        if (!fields || !fields[0])
+            continue;
+
+        RemoteMode mode = { 0, 0 };
+        if (remote_mode_parse (fields[0], &mode))
+            remote_mode_list_add_unique (modes, &mode);
+    }
+
+    return output;
+}
+
+static GArray *
+remote_display_build_mode_candidates (GArray *available, const RemoteMode *requested)
+{
+    GArray *candidates = g_array_new (FALSE, FALSE, sizeof (RemoteMode));
+    GArray *smaller = g_array_new (FALSE, FALSE, sizeof (RemoteMode));
+    GArray *larger = g_array_new (FALSE, FALSE, sizeof (RemoteMode));
+
+    for (guint i = 0; i < available->len; i++)
+    {
+        RemoteMode mode = g_array_index (available, RemoteMode, i);
+        if (remote_mode_equal (&mode, requested))
+        {
+            remote_mode_list_add_unique (candidates, &mode);
+            continue;
+        }
+
+        if (mode.width <= requested->width && mode.height <= requested->height)
+            remote_mode_list_add_unique (smaller, &mode);
+        else
+            remote_mode_list_add_unique (larger, &mode);
+    }
+
+    g_array_sort (smaller, remote_mode_compare_desc);
+    g_array_sort (larger, remote_mode_compare_asc);
+
+    for (guint i = 0; i < smaller->len; i++)
+    {
+        RemoteMode mode = g_array_index (smaller, RemoteMode, i);
+        remote_mode_list_add_unique (candidates, &mode);
+    }
+
+    if (candidates->len == 0)
+    {
+        for (guint i = 0; i < larger->len; i++)
+        {
+            RemoteMode mode = g_array_index (larger, RemoteMode, i);
+            remote_mode_list_add_unique (candidates, &mode);
+        }
+    }
+
+    g_array_unref (smaller);
+    g_array_unref (larger);
+    return candidates;
+}
+
+static gboolean
+remote_display_apply_mode (Seat *seat, gchar **env, const gchar *output, const RemoteMode *mode)
+{
+    g_autofree gchar *mode_name = g_strdup_printf ("%ux%u", mode->width, mode->height);
+    gchar *argv[] = { "xrandr", "--output", (gchar *) output, "--mode", mode_name, NULL };
+    return remote_display_run_xrandr (seat, env, argv, NULL);
+}
+
+gboolean
+remote_display_prepare_resolution (Seat *seat, XServerLocal *x_server)
+{
+    RemoteMode requested = { 0, 0 };
+    if (!remote_display_parse_requested_mode (seat, &requested))
+        return TRUE;
+
+    g_auto(GStrv) env = remote_display_build_xrandr_env (x_server);
+    /* Query actual runtime modes with xrandr --query after Xorg is ready. */
+    gchar *query_argv[] = { "xrandr", "--query", NULL };
+    g_autofree gchar *query = NULL;
+    if (!remote_display_run_xrandr (seat, env, query_argv, &query))
+        return TRUE;
+
+    g_autoptr(GArray) modes = g_array_new (FALSE, FALSE, sizeof (RemoteMode));
+    g_autofree gchar *output = remote_display_parse_xrandr_modes (query, modes);
+    if (!output || modes->len == 0)
+    {
+        l_warning (seat, "remote-display: xrandr-apply requested=%ux%u result=keep-current reason=no-output-or-mode",
+                   requested.width,
+                   requested.height);
+        return TRUE;
+    }
+
+    g_autoptr(GString) mode_names = g_string_new ("");
+    for (guint i = 0; i < modes->len; i++)
+    {
+        RemoteMode mode = g_array_index (modes, RemoteMode, i);
+        if (i > 0)
+            g_string_append_c (mode_names, ',');
+        g_string_append_printf (mode_names, "%ux%u", mode.width, mode.height);
+    }
+    l_debug (seat, "remote-display: xrandr-modes output=%s requested=%ux%u modes=%s",
+             output,
+             requested.width,
+             requested.height,
+             mode_names->str);
+
+    g_autoptr(GArray) candidates = remote_display_build_mode_candidates (modes, &requested);
+    for (guint i = 0; i < candidates->len; i++)
+    {
+        RemoteMode candidate = g_array_index (candidates, RemoteMode, i);
+        if (!remote_display_apply_mode (seat, env, output, &candidate))
+            continue;
+
+        const gchar *result = remote_mode_equal (&candidate, &requested) ? "success" : "fallback";
+        l_debug (seat, "remote-display: xrandr-apply output=%s requested=%ux%u applied=%ux%u result=%s",
+                 output,
+                 requested.width,
+                 requested.height,
+                 candidate.width,
+                 candidate.height,
+                 result);
+
+        g_autofree gchar *width_str = g_strdup_printf ("%u", candidate.width);
+        g_autofree gchar *height_str = g_strdup_printf ("%u", candidate.height);
+        seat_set_property (seat, "remote-width", width_str);
+        seat_set_property (seat, "remote-height", height_str);
+        return TRUE;
+    }
+
+    l_warning (seat, "remote-display: xrandr-apply output=%s requested=%ux%u result=keep-current reason=no-usable-mode",
+               output,
+               requested.width,
+               requested.height);
+    return TRUE;
+}
--- a/src/remote-display-resolution.h
+++ b/src/remote-display-resolution.h
@@ -0,0 +1,19 @@
+/*
+ * Runtime resolution selection for remote displays.
+ */
+
+#ifndef REMOTE_DISPLAY_RESOLUTION_H_
