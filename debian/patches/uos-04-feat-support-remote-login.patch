+    g_return_val_if_fail (seat != NULL, NULL);
+
+    SeatPrivate *priv = seat_get_instance_private (seat);
+
+    return priv->remote_single_logon_password;
+}
+
+static gboolean
+seat_get_remote_single_logon_credentials (Seat *seat, const gchar **out_user, const gchar **out_password)
+{
+    const gchar *remote_mode = seat_get_string_property (seat, "remote-mode");
+    if (g_strcmp0 (remote_mode, "single-logon") != 0)
+        return FALSE;
+
+    const gchar *remote_user = seat_get_string_property (seat, "remote-user");
+    const gchar *remote_password = seat_get_remote_single_logon_password (seat);
+    if (!remote_user || remote_user[0] == '\0' || !remote_password || remote_password[0] == '\0')
+        return FALSE;
+
+    if (out_user)
+        *out_user = remote_user;
+    if (out_password)
+        *out_password = remote_password;
+
+    return TRUE;
+}
+
+/* Single-logon supplies the remote password to PAM prompts without involving a greeter UI. */
+static void
+seat_remote_single_logon_messages_cb (Session *session, Seat *seat)
+{
+    const struct pam_message *messages = session_get_messages (session);
+    int messages_length = session_get_messages_length (session);
+    int n_prompts = 0;
+
+    for (int i = 0; i < messages_length; i++)
+    {
+        int msg_style = messages[i].msg_style;
+        if (msg_style == PAM_PROMPT_ECHO_OFF || msg_style == PAM_PROMPT_ECHO_ON)
+            n_prompts++;
+    }
+
+    g_message ("remote-display: single-logon-auth messages=%d prompts=%d", messages_length, n_prompts);
+
+    if (n_prompts == 0)
+    {
+        struct pam_response *response = calloc (messages_length, sizeof (struct pam_response));
+        g_message ("remote-display: single-logon-auth action=respond pipe=default reason=no-prompts");
+        session_respond (session, response);
+        free (response);
+        return;
+    }
+
+    const gchar *password = seat_get_remote_single_logon_password (seat);
+    if (!password || password[0] == '\0')
+    {
+        g_message ("remote-display: single-logon-auth action=respond result=fail pipe=prompt reason=missing-password");
+        session_prompt_respond_error (session, PAM_CONV_ERR);
+        return;
+    }
+
+    struct pam_response *response = calloc (messages_length, sizeof (struct pam_response));
+    for (int i = 0; i < messages_length; i++)
+    {
+        int msg_style = messages[i].msg_style;
+        if (msg_style == PAM_PROMPT_ECHO_OFF || msg_style == PAM_PROMPT_ECHO_ON)
+            response[i].resp = g_strdup (password);
+    }
+
+    g_message ("remote-display: single-logon-auth action=respond pipe=prompt prompts=%d", n_prompts);
+    session_prompt_respond (session, response);
+
+    for (int i = 0; i < messages_length; i++)
+        remote_display_clear_secret (&response[i].resp);
+    free (response);
+}
+
+static void
+seat_remote_single_logon_auth_complete_cb (Session *session, Seat *seat)
+{
+    (void) session;
+    g_message ("remote-display: single-logon-auth action=clear-password result=authentication-complete");
+    seat_set_remote_single_logon_password (seat, NULL);
+}
